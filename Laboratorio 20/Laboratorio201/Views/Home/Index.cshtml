@{
    ViewBag.Title = "Tabla de Multiplicar";
}

<h2>Tabla de Multiplicar</h2>

<form action="/Home/CalcularTabla" method="post">
    <div>
        <label>Ingrese un número:</label>
        <input type="number" name="numero" class="form-control" min="1" max="1000" required>
    </div>

    <button type="submit" class="btn btn-primary">Generar Tabla</button>
</form>

@if (ViewBag.Error != null)
{
<div class="alert alert-danger">@ViewBag.Error</div>
}

@if (ViewBag.MostrarTabla != null)
{
<h3>Tabla del @ViewBag.Numero</h3>
<table class="table">
    <thead>
        <tr>
            <th>Multiplicación</th>
            <th>Resultado</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 1; i <= 25; i++)
            {
        <tr>
            <td>@ViewBag.Numero × @i</td>
            <td>@(ViewBag.Numero * i)</td>
        </tr>
            }
    </tbody>
</table>
}